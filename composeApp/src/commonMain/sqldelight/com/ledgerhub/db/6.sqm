-- Migration 6 → 7 — US-18, Rapprochement bancaire (lettrage).
--
-- Deux tables nouvelles. `Schema.create` ne s'exécutant que sur une base neuve, ce .sqm les
-- installe sur les bases déjà déployées (dette A-01, close en US-05). L'invariant est vérifié par
-- SchemaMigrationVerificationTest, qui migre chaque instantané databases/N.db et le compare au
-- schéma courant.
--
-- Les définitions sont recopiées à l'identique de BankTransaction.sq et ReconciliationMatch.sq :
-- toute divergence, jusqu'à l'ordre des colonnes, ferait échouer la comparaison de schéma.
CREATE TABLE BankTransaction (
    id TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    amountCents INTEGER NOT NULL,
    valueDate TEXT NOT NULL,
    counterparty TEXT NOT NULL DEFAULT ''
);

CREATE INDEX BankTransaction_valueDate ON BankTransaction(valueDate);

CREATE TABLE ReconciliationMatch (
    transactionId TEXT NOT NULL PRIMARY KEY,
    invoiceNumber TEXT NOT NULL,
    matchedAt TEXT NOT NULL,
    deltaCents INTEGER NOT NULL,
    FOREIGN KEY (transactionId) REFERENCES BankTransaction(id),
    FOREIGN KEY (invoiceNumber) REFERENCES Invoice(number) ON DELETE CASCADE
);

CREATE UNIQUE INDEX ReconciliationMatch_invoice ON ReconciliationMatch(invoiceNumber);
