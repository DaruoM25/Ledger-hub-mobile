-- Avoir d'annulation intégrale d'une facture — toujours lié à Invoice(number), montants négatifs
-- (voir domain.creditnote.CreditNote). Pas de UPDATE : un avoir, comme une facture finalisée,
-- est un document fiscal immuable une fois émis (une correction s'exprime par un nouvel avoir,
-- jamais par l'édition d'un avoir existant).
CREATE TABLE CreditNote (
    number TEXT NOT NULL PRIMARY KEY,
    issueDate TEXT NOT NULL,
    invoiceNumber TEXT NOT NULL,
    reason TEXT NOT NULL,
    userEmail TEXT NOT NULL,
    issuerName TEXT NOT NULL,
    issuerSiren TEXT NOT NULL,
    issuerSiret TEXT NOT NULL,
    recipientSiret TEXT NOT NULL,
    totalHtCents INTEGER NOT NULL,
    totalVatCents INTEGER NOT NULL,
    totalTtcCents INTEGER NOT NULL,
    -- Date d'émission de la facture annulée. Recopiée sur l'avoir : la référence croisée attendue
    -- par Factur-X 2026 est le couple numéro + date, pas le seul numéro. DEFAULT '' pour les
    -- avoirs antérieurs à la colonne. Déclarée en dernier pour coïncider avec la position que lui
    -- donne l'ALTER TABLE de la migration 1.sqm — sans quoi verifyMigrations signale un écart.
    originalInvoiceDate TEXT NOT NULL DEFAULT '',
    FOREIGN KEY (invoiceNumber) REFERENCES Invoice(number),
    FOREIGN KEY (recipientSiret) REFERENCES Customer(siret)
);

insertOrReplace:
INSERT OR REPLACE INTO CreditNote(number, issueDate, invoiceNumber, originalInvoiceDate, reason, userEmail, issuerName, issuerSiren, issuerSiret, recipientSiret, totalHtCents, totalVatCents, totalTtcCents)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Dernier numéro attribué pour un exercice donné (motif `AV-2026-%`). Le tri lexicographique
-- suffit : le suffixe est à largeur fixe sur 4 chiffres (voir CreditNoteNumbering).
selectLastNumberForPrefix:
SELECT number FROM CreditNote
WHERE number LIKE ?
ORDER BY number DESC
LIMIT 1;

selectAll:
SELECT * FROM CreditNote;

selectByUserEmail:
SELECT * FROM CreditNote
WHERE userEmail = ?;

selectByInvoiceNumber:
SELECT * FROM CreditNote
WHERE invoiceNumber = ?;

selectByNumber:
SELECT * FROM CreditNote
WHERE number = ?;

deleteByNumber:
DELETE FROM CreditNote
WHERE number = ?;
