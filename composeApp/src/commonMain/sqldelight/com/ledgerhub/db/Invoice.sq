-- L'émetteur reste embarqué (c'est toujours la même entreprise, celle de l'utilisateur) ;
-- seul le destinataire est normalisé vers Customer (réutilisé d'une facture à l'autre).
CREATE TABLE Invoice (
    number TEXT NOT NULL PRIMARY KEY,
    issueDate TEXT NOT NULL,
    status TEXT NOT NULL,
    -- Numéro du devis d'origine si cette facture vient d'une conversion — piste d'audit fiscale.
    sourceQuoteId TEXT,
    -- Compte propriétaire de cette facture côté app (SaaS multi-utilisateurs) — voir selectByUserEmail.
    userEmail TEXT NOT NULL,
    issuerName TEXT NOT NULL,
    issuerSiren TEXT NOT NULL,
    issuerSiret TEXT NOT NULL,
    recipientSiret TEXT NOT NULL,
    -- Identité du destinataire GELÉE au moment de l'émission. La fiche Customer peut évoluer
    -- (changement de raison sociale, nouveau contact) ; une facture déjà émise ne doit jamais
    -- voir son destinataire réécrit rétroactivement — immutabilité de la piste d'audit Factur-X.
    -- DEFAULT '' pour les factures héritées : le repository retombe alors sur la fiche Customer.
    recipientName TEXT NOT NULL DEFAULT '',
    recipientEmail TEXT NOT NULL DEFAULT '',
    -- Échéance de paiement (AAAA-MM-JJ). DEFAULT '' pour les factures héritées sans échéance.
    dueDate TEXT NOT NULL DEFAULT '',
    -- Génération au format légal Factur-X (1 = oui). DEFAULT 1 : conformité 2026 par défaut.
    facturX INTEGER NOT NULL DEFAULT 1,
    -- Pénalités de retard légales B2B, art. L.441-10 du Code de commerce (1 = oui).
    -- DEFAULT 1 : la mention est obligatoire entre professionnels, y compris pour les factures
    -- héritées, dont l'aperçu imprimait déjà des pénalités de retard inconditionnellement.
    applyB2bPenalties INTEGER NOT NULL DEFAULT 1,
    -- Réforme 2026 (US-27)
    clientSiren TEXT NOT NULL DEFAULT '',
    natureOperation TEXT NOT NULL DEFAULT 'PRESTATION_SERVICES',
    optionTvaDebit INTEGER NOT NULL DEFAULT 0,
    isEReporting INTEGER NOT NULL DEFAULT 0,
    deliveryStreet TEXT NOT NULL DEFAULT '',
    deliveryZip TEXT NOT NULL DEFAULT '',
    deliveryCity TEXT NOT NULL DEFAULT '',
    deliveryCountry TEXT NOT NULL DEFAULT '',
    -- Cycle de vie réglementaire (US-28)
    refusalReason TEXT,
    FOREIGN KEY (recipientSiret) REFERENCES Customer(siret)
);

insertOrReplace:
INSERT OR REPLACE INTO Invoice(
    number, issueDate, status, sourceQuoteId, userEmail,
    issuerName, issuerSiren, issuerSiret,
    recipientSiret, recipientName, recipientEmail,
    dueDate, facturX, applyB2bPenalties,
    clientSiren, natureOperation, optionTvaDebit, isEReporting,
    deliveryStreet, deliveryZip, deliveryCity, deliveryCountry,
    refusalReason
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM Invoice;

selectByUserEmail:
SELECT * FROM Invoice
WHERE userEmail = ?;

selectByNumber:
SELECT * FROM Invoice
WHERE number = ?;

-- Le semis de démonstration s'appuie sur ce comptage, et non sur une lecture de toutes les
-- factures : une seule ligne indésérialisable faisait échouer la lecture complète, le semis
-- concluait « base vide » et réécrivait les factures de démonstration par-dessus les vraies.
-- Un COUNT ne construit aucun objet de domaine : il ne peut pas échouer pour cette raison.
countByUserEmail:
SELECT COUNT(*) FROM Invoice
WHERE userEmail = ?;

-- Garde-fou de suppression d'une fiche client : on ne retire pas de l'historique un
-- destinataire qui figure sur des factures déjà émises (voir ClientRepository.deleteClient).
countByRecipientSiret:
SELECT COUNT(*) FROM Invoice
WHERE recipientSiret = ?;

updateStatus:
UPDATE Invoice
SET status = ?
WHERE number = ?;

updateStatusAndReason:
UPDATE Invoice
SET status = ?, refusalReason = ?
WHERE number = ?;

deleteByNumber:
DELETE FROM Invoice
WHERE number = ?;
