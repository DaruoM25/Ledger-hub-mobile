-- Client (destinataire) réutilisable entre devis/factures. SIRET = identité métier unique.
CREATE TABLE Customer (
    siret TEXT NOT NULL PRIMARY KEY,
    siren TEXT NOT NULL,
    name TEXT NOT NULL,
    -- Coordonnée de contact du client — mention Factur-X 2026. DEFAULT '' pour les clients hérités.
    email TEXT NOT NULL DEFAULT ''
);

-- Crée la fiche client si le SIRET est inconnu, sinon NE TOUCHE À RIEN.
-- Un INSERT OR REPLACE écrasait la raison sociale enregistrée dès qu'une nouvelle facture
-- réutilisait un SIRET connu sous un autre nom, et réécrivait ainsi l'historique déjà émis.
-- La mise à jour délibérée d'une fiche client relève d'une action dédiée (écran Clients),
-- pas d'un effet de bord de l'émission — voir updateIdentity.
-- OR IGNORE plutôt que la syntaxe UPSERT : le dialecte SQLDelight du projet est SQLite 3.18,
-- antérieur à ON CONFLICT DO NOTHING. Sémantique identique sur un conflit de clé primaire.
insertIfAbsent:
INSERT OR IGNORE INTO Customer(siret, siren, name, email)
VALUES (?, ?, ?, ?);

-- Mise à jour explicite d'une fiche client existante. Sans effet sur les factures déjà émises,
-- qui portent leur propre copie gelée du destinataire (voir Invoice.recipientName).
updateIdentity:
UPDATE Customer
SET siren = ?, name = ?, email = ?
WHERE siret = ?;

selectAll:
SELECT * FROM Customer;

-- Recherche par préfixe de raison sociale, insensible à la casse (US-11, sélecteur client).
-- `COLLATE NOCASE` porte sur la comparaison LIKE : « bou », « Bou » et « BOU » ramènent la même
-- liste. Attention, NOCASE de SQLite ne replie que l'ASCII — « É » ne matche pas « é ». Ce n'est
-- pas gênant pour un préfixe de raison sociale française, presque toujours saisi sans accent
-- initial ; le jour où ça le deviendra, il faudra une colonne de nom normalisé.
-- Aucune modification de schéma ici : une requête nommée ne participe pas au hash vérifié par
-- verifyMigrations, la base reste en v5.
searchByNamePrefix:
SELECT * FROM Customer
WHERE name LIKE ? || '%' COLLATE NOCASE
ORDER BY name;

selectBySiret:
SELECT * FROM Customer
WHERE siret = ?;

deleteBySiret:
DELETE FROM Customer
WHERE siret = ?;
