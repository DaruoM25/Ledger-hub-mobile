<?xml version="1.0" encoding="utf-8"?>
<!--
  Liste blanche du trafic HTTP en clair (non chiffré). Android bloque tout cleartext par défaut
  depuis l'API 28 ; sans exception, chaque appel échoue immédiatement avec
  "Cleartext HTTP traffic to <hôte> not permitted", avant même d'atteindre le serveur.

  Cette configuration a le dernier mot sur `android:usesCleartextTraffic` du manifeste (API 24+) :
  un hôte qui ne figure pas ici reste bloqué, quel que soit le drapeau global. Tout backend en
  clair doit donc être déclaré ci-dessous.

  Hôtes autorisés :
  - 130.61.25.71   backend métier joignable depuis un appareil physique (voir
                   `ledgerhub.apiBaseUrl` dans composeApp/build.gradle.kts) ;
  - 10.0.2.2       alias de la boucle locale de la machine hôte vu depuis l'émulateur Android ;
  - localhost / 127.0.0.1  serveur local, utile aux tests instrumentés.

  À retirer/restreindre dès qu'un backend HTTPS remplace le serveur en clair.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">130.61.25.71</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
