<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Le backend metier (US-26+) est servi en HTTP non chiffre. Deux verrous Android doivent
      ceder pour qu'un appel parte :
        1. `usesCleartextTraffic` : le drapeau global du manifeste, false par defaut depuis
           API 28. Pose ici a `true` pour que l'intention soit lisible dans le manifeste meme.
        2. `networkSecurityConfig` : la liste blanche fine. Sur API 24+ elle a le dernier mot
           et *ecrase* le drapeau ci-dessus — un hote absent de res/xml/network_security_config.xml
           reste bloque, drapeau ou pas. C'est donc la que se declare chaque backend en clair.
    -->
    <application
        android:allowBackup="true"
        android:label="LedgerHub"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LedgerHub">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LedgerHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Partage du XML Factur-X (US-06). Depuis Android 7, transmettre une URI `file://` à une
          autre application lève FileUriExposedException : le provider délivre une `content://`
          assortie d'une permission temporaire. `exported=false` + `grantUriPermissions=true` :
          aucune application ne peut interroger le provider, seule celle qui reçoit l'Intent
          obtient l'accès, et uniquement au fichier transmis.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
