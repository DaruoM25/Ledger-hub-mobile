# ==============================================================================
# LedgerHub Mobile — Variables d'Environnement & Secrets (.env.example)
# ==============================================================================
# Copiez ce fichier vers .env ou renseignez ces valeurs dans local.properties / CI
# ATTENTION : Ne commitez JAMAIS de clés de production réelles dans Git !

# ── Endpoints Réseau ─────────────────────────────────────────────────────────
# URL de base de l'API LedgerHub (Factur-X / Backend)
LEDGERHUB_API_BASE_URL=https://api.ledgerhub.fr

# ── Monétisation & Abonnements ───────────────────────────────────────────────
# Clés publiques RevenueCat (Shipaton Pro Mobile)
REVENUECAT_PUBLIC_KEY_ANDROID=appl_mock_android_public_key_xxxx
REVENUECAT_PUBLIC_KEY_IOS=appl_mock_ios_public_key_xxxx

# ── Services Tiers Partenaires ───────────────────────────────────────────────
# API SIRENE / DGFIP (si token requis)
SIRENE_API_KEY=mock_sirene_api_token
