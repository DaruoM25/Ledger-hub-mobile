#!/usr/bin/env bash
#
# .githooks/pre-commit - Protection anti-fuite de secrets LedgerHub Mobile.
# Analyse les modifications indexées (staged) avant chaque commit.
#
set -euo pipefail

RED=$'\033[31m'
YELLOW=$'\033[33m'
GREEN=$'\033[32m'
RESET=$'\033[0m'

echo "==> [pre-commit] Analyse anti-fuite de secrets..."

# Fichiers sensibles qui ne doivent jamais être indexés
FORBIDDEN_FILES_REGEX='(\.(jks|keystore|pem|key)$|\.env|google-services\.json|local\.properties$)'
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

LEAKS_DETECTED=0

# 1. Vérification des noms de fichiers interdits
for file in $STAGED_FILES; do
    if [[ "$file" == *".env.example"* || "$file" == *".env.sample"* || "$file" == *".env.template"* ]]; then
        continue
    fi
    if echo "$file" | grep -iE "$FORBIDDEN_FILES_REGEX" > /dev/null 2>&1; then
        echo "${RED}[ERREUR] Fichier sensible interdit indexé : $file${RESET}"
        LEAKS_DETECTED=1
    fi
done

# 2. Vérification des motifs de secrets dans le contenu ajouté/modifié
DIFF_CONTENT=$(git diff --cached -U0 --diff-filter=ACM)

# Motifs de détection regex
PATTERNS=(
    "BEGIN (RSA|EC|DSA|OPENSSH|PGP|ENCRYPTED)? ?PRIVATE KEY"
    "(AKIA|ASIA)[0-9A-Z]{16}"
    "ey[A-Za-z0-9_-]{15,}\.[A-Za-z0-9_-]{15,}\.[A-Za-z0-9._-]{15,}"
    "(api_key|apikey|secret_key|client_secret|auth_token|access_token)[[:space:]]*[:=][[:space:]]*['\"][A-Za-z0-9_\-]{16,}['\"]"
    "(password|passwd|pwd)[[:space:]]*[:=][[:space:]]*['\"][^'\"]{6,}['\"]"
)

for pattern in "${PATTERNS[@]}"; do
    MATCHES=$(echo "$DIFF_CONTENT" | grep -nE "^\+[^+]" | grep -iE "$pattern" || true)
    if [ -n "$MATCHES" ]; then
        echo "${RED}[ERREUR] Secret potentiel détecté avec le motif '$pattern' :${RESET}"
        echo "$MATCHES" | head -n 5
        LEAKS_DETECTED=1
    fi
done

if [ "$LEAKS_DETECTED" -ne 0 ]; then
    echo ""
    echo "${RED}❌ COMMIT REJETÉ : Des secrets ou fichiers sensibles ont été détectés.${RESET}"
    echo "${YELLOW}Conseils :${RESET}"
    echo "  1. Retirez le fichier ou la chaîne sensible de l'index : git reset HEAD <fichier>"
    echo "  2. Utilisez des variables d'environnement ou BuildConfig au lieu de secrets en dur."
    echo "  3. En cas de faux-positif avéré (ex: fixture de test), vous pouvez forcer avec : git commit --no-verify"
    echo ""
    exit 1
fi

echo "${GREEN}[OK] Aucun secret détecté dans le commit.${RESET}"
exit 0
